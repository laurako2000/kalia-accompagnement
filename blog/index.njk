---
title: Conseils & Ressources
description: Des articles concrets pour mieux comprendre ce que vous traversez et trouver des pistes d'action au quotidien.
permalink: /blog/index.html
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{ title }} – {{ site.name }}</title>
  <meta name="description" content="{{ description }}"/>
  <link rel="canonical" href="{{ site.url }}{{ page.url }}"/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content="{{ title }} – {{ site.name }}"/>
  <meta property="og:description" content="{{ description }}"/>
  <meta property="og:url" content="{{ site.url }}{{ page.url }}"/>
  <meta property="og:image" content="{{ site.defaultImage | absoluteUrl(site.url) }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/shared.css"/>
  <style>
    .article-card-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:28px; margin-top:8px; }
    @media(max-width:960px){ .article-card-grid{grid-template-columns:1fr 1fr} }
    @media(max-width:640px){ .article-card-grid{grid-template-columns:1fr} }
    .blog-search { display:flex; align-items:center; gap:12px; max-width:520px; margin:0 auto 32px; padding:14px 20px; background:#fff; border:1.5px solid var(--grey-bd); border-radius:100px; color:var(--grey-tx); transition:border-color .2s; }
    .blog-search:focus-within { border-color:var(--teal); }
    .blog-search input { flex:1; border:none; outline:none; font-family:'Inter',sans-serif; font-size:.92rem; color:var(--navy); background:transparent; }
    .blog-search input::placeholder { color:var(--grey-tx); }
  </style>
</head>
<body>

{% include "nav.njk" %}

<div class="page-hero">
  <div class="container">
    <div class="section-label" style="justify-content:center">Ressources</div>
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>
  </div>
</div>

<section>
  <div class="container">

    <div class="blog-search">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="search" id="blogSearch" placeholder="Rechercher un article (burn-out, confiance, séparation…)" oninput="searchArticles(this.value)" aria-label="Rechercher un article"/>
    </div>

    <div class="filter-bar" id="filterBar">
      <button class="filter-btn active" onclick="filterArticles('all',this)">Tous</button>
      {% for cat in blogCategories %}
      <button class="filter-btn" onclick="filterArticles('{{ cat | slugify }}',this)">{{ cat }}</button>
      {% endfor %}
    </div>

    <div class="article-card-grid" id="articleGrid">
      {% for post in collections.posts %}
      <a class="article-card" href="{{ post.url }}" data-cat="{{ post.data.categories | slugifyList }}" data-search="{{ (post.data.title ~ ' ' ~ post.data.description ~ ' ' ~ (post.data.categories | join(' '))) | lower }}">
        <div class="article-thumb">
          <img src="{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy"/>
        </div>
        <div class="article-body">
          <div class="article-cat">{{ post.data.categories | join(" · ") }} · {{ post.data.date | formatDate }}</div>
          <div class="article-title">{{ post.data.title }}</div>
          <div class="article-excerpt">{{ post.data.description }}</div>
          <div class="article-link">Lire l'article <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
        </div>
      </a>
      {% endfor %}
    </div>

    <p id="noResults" style="display:none;text-align:center;color:var(--grey-tx);padding:60px 0">Aucun article ne correspond à votre recherche.</p>

    {% if collections.posts | length == 0 %}
    <p style="text-align:center;color:var(--grey-tx);padding:60px 0">Aucun article publié pour le moment. Les nouveaux articles créés depuis l'espace d'administration (<a href="/admin/" style="color:var(--teal-d)">/admin</a>) apparaîtront ici automatiquement.</p>
    {% endif %}

  </div>
</section>

{% include "footer.njk" %}

<script src="/shared.js"></script>
<script>
let currentCategory = 'all';
let currentSearch = '';

function filterArticles(cat, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  currentCategory = cat;
  applyFilters();
}

function searchArticles(query) {
  currentSearch = (query || '').trim().toLowerCase();
  applyFilters();
}

function applyFilters() {
  let visibleCount = 0;
  document.querySelectorAll('#articleGrid .article-card').forEach(card => {
    const cats = (card.dataset.cat || '').split(' ');
    const matchesCategory = (currentCategory === 'all' || cats.includes(currentCategory));
    const matchesSearch = (currentSearch === '' || (card.dataset.search || '').includes(currentSearch));
    const visible = matchesCategory && matchesSearch;
    card.style.display = visible ? '' : 'none';
    if (visible) visibleCount++;
  });
  document.getElementById('noResults').style.display = visibleCount === 0 ? 'block' : 'none';
}
</script>
</body>
</html>
